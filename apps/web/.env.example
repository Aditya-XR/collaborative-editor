# Copy to apps/web/.env.local if you need to override the defaults. Values here are public.

# REST base path. /api works locally (Vite proxy) and in production (Vercel rewrite).
VITE_API_URL=/api

# WebSocket origin for live editing. Leave unset locally (same origin, through the Vite proxy).
# Production: wss://YOUR-API.onrender.com, because Vercel rewrites cannot carry WebSockets.
# VITE_WS_URL=
