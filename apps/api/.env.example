# Copy to apps/api/.env for local development. Never commit the real .env.

ENV=development
LOG_LEVEL=INFO

# Local defaults match infra/docker-compose.yml. In production use Neon's URL with
# the asyncpg driver: postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://collabedit:collabedit@localhost:5433/collabedit

# Local Redis from docker compose. In production: rediss://default:PASS@HOST:PORT (Redis Cloud)
REDIS_URL=redis://localhost:6380/0

# Web app origin, used for CORS.
FRONTEND_URL=http://localhost:5173

# Signs access tokens. Required in production (the app refuses to start without it):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=

# true in production (HTTPS only); false for http://localhost.
COOKIE_SECURE=false

# Token bucket limits backed by Redis. Leave on; tests switch it off per case.
RATE_LIMIT_ENABLED=true

# Added in later phases:
# GOOGLE_CLIENT_ID=      (phase 8)
# GOOGLE_CLIENT_SECRET=  (phase 8)
# SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= EMAIL_FROM=  (phase 8)
# GEMINI_API_KEY=        (phase 10)
# SENTRY_DSN=            (phase 11)
